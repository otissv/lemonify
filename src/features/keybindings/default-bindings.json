{
  "version": 1,
  "bindings": {
    "edit.undo": ["mod+z"],
    "edit.redo": ["mod+shift+z", "mod+y"],
    "edit.insertImage": ["alt+i"],
    "edit.replaceImage": ["alt+shift+i"],
    "edit.showOriginal": ["backslash"],
    "file.newDocument": ["alt+n"],
    "file.openImage": ["alt+o"],
    "file.openLibrary": ["alt+shift+o"],
    "file.importDocument": [],
    "file.exportImage": ["alt+x"],
    "file.exportDocument": ["alt+shift+x"],
    "file.close": ["alt+w"],
    "step.group": ["alt+g"],
    "step.ungroup": ["alt+shift+g"],
    "step.delete": ["delete", "backspace"],
    "step.toggle": ["h"],
    "step.moveUp": ["alt+bracketright"],
    "step.moveDown": ["alt+bracketleft"],
    "step.selectUp": ["alt+arrowup"],
    "step.selectDown": ["alt+arrowdown"],
    "view.zoomIn": ["equal", "shift+equal", "numpadadd"],
    "view.zoomOut": ["minus", "numpadsubtract"],
    "view.fit": ["0"],
    "view.actualSize": ["1"],
    "view.panLeft": ["arrowleft"],
    "view.panRight": ["arrowright"],
    "view.panUp": ["arrowup"],
    "view.panDown": ["arrowdown"],
    "view.panLeftFar": ["shift+arrowleft"],
    "view.panRightFar": ["shift+arrowright"],
    "view.panUpFar": ["shift+arrowup"],
    "view.panDownFar": ["shift+arrowdown"],
    "view.sidebar": ["alt+0"],
    "panel.tools": ["alt+1"],
    "panel.options": ["alt+2"],
    "panel.export": ["alt+3"],
    "panel.results": ["alt+4"],
    "panel.document": ["alt+5"],
    "panel.navigator": ["alt+6"],
    "help.shortcuts": ["shift+slash"],
    "tool.sharp.resize": ["r"],
    "tool.sharp.extract": ["c"],
    "tool.sharp.rotate": ["shift+r"],
    "tool.sharp.flip": ["v"],
    "tool.sharp.flop": ["shift+v"],
    "tool.sharp.blur": ["b"],
    "tool.sharp.sharpen": ["s"],
    "tool.sharp.modulate": ["m"],
    "tool.sharp.gamma": ["g"],
    "tool.sharp.threshold": ["t"],
    "tool.sharp.negate": ["n"],
    "tool.sharp.tint": ["shift+t"],
    "tool.sharp.opacity": ["o"],
    "tool.sharp.greyscale": ["shift+g"],
    "tool.ai.upscale": ["u"]
  }
}
