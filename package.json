{
  "name": "lemonify",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "generate-routes": "vite build",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "biome lint .",
    "format": "biome check --write .",
    "check": "biome check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "images": "node --disable-warning=ExperimentalWarning --experimental-transform-types --import ./scripts/images/register-alias.ts scripts/images/index.ts",
    "e2e": "playwright test",
    "e2e:update": "playwright test --update-snapshots"
  },
  "dependencies": {
    "@remixicon/react": "^4.9.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "^0.10.14",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-devtools": "^1.167.3",
    "@tanstack/react-start": "^1.169.5",
    "@xyflow/react": "^12.12.1",
    "better-auth": "^1.7.25",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "knex": "^3.3.0",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.3.6",
    "use-debounce": "^10.1.1",
    "ws": "^8.23.0",
