    "@tanstack/react-router-devtools": "^1.167.3",
    "@tanstack/react-start": "^1.169.5",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "radix-ui": "^1.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.3.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "^0.8.6",
