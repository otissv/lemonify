    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.15.0",
    "jsdom": "^31.0.1",
    "opencomic-ai-bin": "1.6.1",
    "prettier": "^3.8.1",
    "sharp": "^0.35.5",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^5.1.0"
